MYSQL_HOST=your-server.mysql.database.azure.com
MYSQL_PORT=3306
MYSQL_DATABASE=your_pos_database
MYSQL_USER=your_db_user
MYSQL_PASSWORD=
JWT_SECRET=change-me-before-use
CORS_ORIGINS=http://localhost:3000
POS_TAX_ROUNDING=down
POS_ENV=development
# Azure MySQLの接続先証明書を検証するCAファイル。必要な環境だけ設定する。
MYSQL_SSL_CA=
# ローカル確認時のみ1。本番環境では必ず0または未設定にする。
POS_DEMO_MODE=0
